{
  "name": "hlist-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iOS-style mobile client for the HList shopping list server",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "vite build && node --test --test-concurrency=1 --test-timeout=120000 'e2e/*.test.mjs'",
    "typecheck": "vue-tsc --noEmit",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@ionic/vue": "^9.0.5",
    "@ionic/vue-router": "^9.0.5",
    "ionicons": "^8.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
